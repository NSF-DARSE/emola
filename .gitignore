node_modules/
.next/
out/
*.tsbuildinfo
next-env.d.ts
.env
.env.local
# Google Cloud service-account credentials. A private key in the repo is a
# credential leak that survives every future clone, so these never get added.
gcloud-key.json
*-service-account*.json
application_default_credentials.json
data/*.db
# Cached poster images from the generative path. Regenerable, and megabytes of
# binary that would churn on every run.
data/generated/
data/*.db-journal
# SQLite's write-ahead log and its shared-memory index. Both are rewritten on
# every run, and the -wal is megabytes of binary, so committing them means a
# large meaningless diff each time the app is opened.
data/*.db-wal
data/*.db-shm
__pycache__/
*.pyc
.venv/
ml/artifacts/
.env.example
# Raw goldset and the token mapping never get committed
data/model/*.xlsx
data/model/*.xls
data/model/*.mapping.json
data/model/*.review.txt
